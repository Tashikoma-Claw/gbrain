# Copy to /home/box/brain-os/state/box.env
# Paths only. API keys stay in ~/.gbrain/sg.env.
BRAIN_OS=/home/box/brain-os
WIKI_HOME=/home/box/.gbrain
INGEST_HOME=/home/box/.gbrain-homes/ingest
WIKI_PGLITE=/home/box/.gbrain/wiki.pglite
INGEST_PGLITE=/home/box/.gbrain-homes/ingest/ingest.pglite
WIKI_CHECKOUT=/home/box/.gbrain/wiki-default-checkout
VAULT_PATH=/home/box/brain-os/vault
NOTION_SNAPSHOT_PATH=/home/box/brain-os/vault/notion-snapshot
NOTION_MEETINGS_PATH=/home/box/brain-os/vault/notion-meetings
AGENTMAIL_PATH=/home/box/brain-os/vault/agentmail
GBRAIN_SERVE_PORT=18792
RESTART_SERVES=/home/box/brain-os/bin/gbrain-restart-serves.sh
# Short PGLite / serve-stop lock. Dream and Loop keep brain-ops.lock.
DB_LOCK_FILE=/home/box/brain-os/state/brain-ops-db.lock
SERVE_GAP_MAX_SECONDS=1200
EMBED_CAP=200
# Uncomment only after agreeing to Voyage spend for at most EMBED_CAP chunks per run.
# EMBED_CONSENT=yes
HOT_PACK_OUT=/home/box/codex-harness/g2-sync/hot-packs/accounts.slim.json
NOTION_WIKI_PATH=/home/box/brain-os/vault/notion-wiki
