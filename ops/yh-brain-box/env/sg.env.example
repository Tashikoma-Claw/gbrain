# Copy to ~/.gbrain/sg.env and chmod 600.
# Cron does not inherit a login shell. gbrain-dream-nightly.sh sources this
# file so zhipu:glm chat phases see a provider key. Do not commit the copy.
# Do not put GBRAIN_DATABASE_URL or DATABASE_URL here; those force Postgres
# and hide the local PGLite brain.
ZHIPUAI_API_KEY=
