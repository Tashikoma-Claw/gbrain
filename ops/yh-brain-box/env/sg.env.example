# Copy to ~/.gbrain/sg.env and chmod 600.
# Cron does not inherit a login shell. Dream, embed, and other box scripts
# source this file. Do not commit the copy.
# Do not put GBRAIN_DATABASE_URL or DATABASE_URL here; those force Postgres
# and hide the local PGLite brain.
#
# Zhipu is for facts and chat. Embeddings stay on Voyage (the provider the
# box already uses). Do not add a second embedding provider here.
ZHIPUAI_API_KEY=
VOYAGE_API_KEY=
