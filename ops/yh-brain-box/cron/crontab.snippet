# YH brain-box. Times are the box local clock (Asia/Hong_Kong).
# Install by editing crontab; do not wipe unrelated lines.
# Long lock (brain-ops.lock): dream and Loop.
# Short lock (brain-ops-db.lock): doctor, embed, backup snapshot.
# Outside dream, a serve-stop window is at most 20 minutes.
# Order is dream, then backup, then doctor. The delta cron stays outside
# that window. Embed and hot packs also stay outside 02:00-03:59.
# Scripts source ~/.gbrain/sg.env themselves. Do not put keys in crontab.
# gbrain-restart-serves.sh is already the :18792 owner; do not add a second serve.
# Do not add a line that runs `gbrain upgrade`.
SHELL=/bin/bash
PATH=/home/box/.bun/bin:/usr/local/bin:/usr/bin:/bin

28 2 * * * /home/box/brain-os/bin/gbrain-dream-nightly.sh >> /home/box/brain-os/logs/dream-nightly.log 2>&1
17 3 * * * /home/box/brain-os/bin/backup-push.sh >> /home/box/brain-os/logs/backup-push.log 2>&1
17 4 * * * /home/box/brain-os/bin/gbrain-daily-hygiene.sh >> /home/box/brain-os/logs/daily-hygiene.log 2>&1
47 4-23,0-1 * * * /home/box/brain-os/bin/gbrain-multi-source-delta.sh >> /home/box/brain-os/logs/multi-source-delta.log 2>&1
10 1,7,13,19 * * * /home/box/brain-os/bin/notion-delta.sh >> /home/box/brain-os/logs/notion-delta.log 2>&1
25 7 * * * /home/box/brain-os/bin/pipeline-digest.sh >> /home/box/brain-os/logs/pipeline-digest.log 2>&1
# Phase 2. Embed is Voyage, cap 200, never --all. Hot packs run only after
# state/hot-pack-approve.json and a successful multi-source preview.
12 0-1,4-23 * * * /home/box/brain-os/bin/gbrain-embed-stale.sh >> /home/box/brain-os/logs/embed-stale.log 2>&1
55 0-1,4-23 * * * /home/box/brain-os/bin/gbrain-hot-pack-rebuild.sh >> /home/box/brain-os/logs/hot-pack.log 2>&1
17 5 * * 0 /home/box/brain-os/bin/gbrain-version-check.sh >> /home/box/brain-os/logs/version-check.log 2>&1
40 5 * * 0 /home/box/brain-os/bin/hub-diff.sh >> /home/box/brain-os/logs/hub-diff.log 2>&1
# Optional, off by default. Uncomment to notice a stuck ingest tail.
# 45 5 * * * /home/box/brain-os/bin/ingest-finish-tail.sh --check >> /home/box/brain-os/logs/ingest-tail.log 2>&1
